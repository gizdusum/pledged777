    "viem": "^2.48.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
